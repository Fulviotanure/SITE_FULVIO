{
  "hosting": {
    "site": "fulviotanure",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".git/**",
      ".firebase/**",
      "node_modules/**",
      "*.log",
      "server.js",
      "package.json",
      "package-lock.json",
      "*.ps1",
      "*.bat",
      "PAGINAS/SITE_FOTO/_ORIGINAIS/**"
    ],
    "redirects": [
      {
        "source": "/PAGINAS/SITE_FOTO",
        "destination": "/fotografia",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_FOTO/index.html",
        "destination": "/fotografia",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_WMACRO",
        "destination": "/wmacro",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_WMACRO/index.html",
        "destination": "/wmacro",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_RIVI",
        "destination": "/rivi",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_RIVI/index.html",
        "destination": "/rivi",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_DEERPRINT",
        "destination": "/deerprint",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_DEERPRINT/index.html",
        "destination": "/deerprint",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_FT%20PDF",
        "destination": "/ftpdf",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_FT%20PDF/index.html",
        "destination": "/ftpdf",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_FT PDF",
        "destination": "/ftpdf",
        "type": 301
      },
      {
        "source": "/PAGINAS/SITE_FT PDF/index.html",
        "destination": "/ftpdf",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/fotografia",
        "destination": "/PAGINAS/SITE_FOTO/index.html"
      },
      {
        "source": "/fotografia/**",
        "destination": "/PAGINAS/SITE_FOTO/index.html"
      },
      {
        "source": "/foto",
        "destination": "/PAGINAS/SITE_FOTO/index.html"
      },
      {
        "source": "/foto/**",
        "destination": "/PAGINAS/SITE_FOTO/index.html"
      },
      {
        "source": "/wmacro",
        "destination": "/PAGINAS/SITE_WMACRO/index.html"
      },
      {
        "source": "/wmacro/**",
        "destination": "/PAGINAS/SITE_WMACRO/index.html"
      },
      {
        "source": "/rivi",
        "destination": "/PAGINAS/SITE_RIVI/index.html"
      },
      {
        "source": "/rivi/**",
        "destination": "/PAGINAS/SITE_RIVI/index.html"
      },
      {
        "source": "/deerprint",
        "destination": "/PAGINAS/SITE_DEERPRINT/index.html"
      },
      {
        "source": "/deerprint/**",
        "destination": "/PAGINAS/SITE_DEERPRINT/index.html"
      },
      {
        "source": "/deer-print",
        "destination": "/PAGINAS/SITE_DEERPRINT/index.html"
      },
      {
        "source": "/deer-print/**",
        "destination": "/PAGINAS/SITE_DEERPRINT/index.html"
      },
      {
        "source": "/deer",
        "destination": "/PAGINAS/SITE_DEERPRINT/index.html"
      },
      {
        "source": "/deer/**",
        "destination": "/PAGINAS/SITE_DEERPRINT/index.html"
      },
      {
        "source": "/PAGINAS/SITE_FOTO",
        "destination": "/PAGINAS/SITE_FOTO/index.html"
      },
      {
        "source": "/PAGINAS/SITE_FOTO/**",
        "destination": "/PAGINAS/SITE_FOTO/index.html"
      },
      {
        "source": "/PAGINAS/SITE_WMACRO",
        "destination": "/PAGINAS/SITE_WMACRO/index.html"
      },
      {
        "source": "/PAGINAS/SITE_WMACRO/**",
        "destination": "/PAGINAS/SITE_WMACRO/index.html"
      },
      {
        "source": "/PAGINAS/SITE_RIVI",
        "destination": "/PAGINAS/SITE_RIVI/index.html"
      },
      {
        "source": "/PAGINAS/SITE_RIVI/**",
        "destination": "/PAGINAS/SITE_RIVI/index.html"
      },
      {
        "source": "/PAGINAS/SITE_DEERPRINT",
        "destination": "/PAGINAS/SITE_DEERPRINT/index.html"
      },
      {
        "source": "/PAGINAS/SITE_DEERPRINT/**",
        "destination": "/PAGINAS/SITE_DEERPRINT/index.html"
      },
      {
        "source": "/ftpdf/privacidade.html",
        "destination": "/PAGINAS/SITE_FT PDF/privacidade.html"
      },
      {
        "source": "/ftpdf/termos.html",
        "destination": "/PAGINAS/SITE_FT PDF/termos.html"
      },
      {
        "source": "/deerprint/privacidade.html",
        "destination": "/PAGINAS/SITE_DEERPRINT/privacidade.html"
      },
      {
        "source": "/deerprint/termos.html",
        "destination": "/PAGINAS/SITE_DEERPRINT/termos.html"
      },
      {
        "source": "/ftpdf",
        "destination": "/PAGINAS/SITE_FT PDF/index.html"
      },
      {
        "source": "/ftpdf/**",
        "destination": "/PAGINAS/SITE_FT PDF/index.html"
      },
      {
        "source": "/ft-pdf",
        "destination": "/PAGINAS/SITE_FT PDF/index.html"
      },
      {
        "source": "/ft-pdf/**",
        "destination": "/PAGINAS/SITE_FT PDF/index.html"
      },
      {
        "source": "/pdf",
        "destination": "/PAGINAS/SITE_FT PDF/index.html"
      },
      {
        "source": "/pdf/**",
        "destination": "/PAGINAS/SITE_FT PDF/index.html"
      },
      {
        "source": "/PAGINAS/SITE_FT PDF",
        "destination": "/PAGINAS/SITE_FT PDF/index.html"
      },
      {
        "source": "/PAGINAS/SITE_FT PDF/**",
        "destination": "/PAGINAS/SITE_FT PDF/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "/PAGINAS/SITE_FOTO/api/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
        ]
      }
    ]
  }
}
